[Unit]
Description=Independent bounded Starlink full-dwell analysis
ConditionPathExists=@RELEASE_ROOT@/release.manifest.json
ConditionPathExists=@RELEASE_ROOT@/validation.receipt.json
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
WorkingDirectory=@RELEASE_ROOT@
Environment="PYTHONNOUSERSITE=1"
Environment="PYTHONPATH=@RELEASE_ROOT@/native/lib/python3.11/site-packages:@RELEASE_ROOT@/native/spf"
Environment="OPENBLAS_NUM_THREADS=1"
Environment="OMP_NUM_THREADS=1"
Environment="MKL_NUM_THREADS=1"
Environment="NUMEXPR_NUM_THREADS=1"
ExecStartPre=@RELEASE_ROOT@/venv/bin/leo-verify-release --manifest @RELEASE_ROOT@/release.manifest.json --receipt @RELEASE_ROOT@/validation.receipt.json --expected-manifest-sha256 @RELEASE_MANIFEST_SHA256@ --expected-receipt-sha256 @RELEASE_RECEIPT_SHA256@
ExecStart=@RELEASE_ROOT@/venv/bin/leo-gauss-full-dwell --credential-directory /home/mouse9911/.local/state/leo-flow/credentials/gauss-analysis --maximum-active 8 --maximum-admissions-per-cycle 2 --poll-seconds 5
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
MemoryHigh=12G
MemoryMax=16G
TasksMax=32
Nice=10
OOMPolicy=stop
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
ReadOnlyPaths=@RELEASE_ROOT@
ReadWritePaths=/home/mouse9911/.local/share/leo-flow

[Install]
WantedBy=default.target
