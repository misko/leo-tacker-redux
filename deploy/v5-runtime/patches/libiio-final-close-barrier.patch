 	if (ret == 0)
 		ret = (int) thd->err;
 	if (ret < 0)
-		remove_thd_entry(thd);
+		remove_thd_entry(thd, false);
 	else
 		SLIST_INSERT_HEAD(&pdata->thdlist_head, thd, parser_list_entry);
 	return ret;
