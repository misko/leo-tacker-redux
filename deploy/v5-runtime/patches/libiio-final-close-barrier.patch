diff --git a/bindings/python/iio.py b/bindings/python/iio.py
index 95c86a7..ff87ffe 100644
--- a/bindings/python/iio.py
+++ b/bindings/python/iio.py
@@ -1013,8 +1013,14 @@ class Buffer(object):
 
     def __del__(self):
         """Destroy this buffer."""
-        if self._buffer is not None:
-            _buffer_destroy(self._buffer)
+        self.close()
+
+    def close(self):
+        """Destroy this buffer immediately; repeated calls are safe."""
+        buffer = getattr(self, "_buffer", None)
+        if buffer is not None:
+            self._buffer = None
+            _buffer_destroy(buffer)
 
     def __len__(self):
         """Size of this buffer, in bytes."""
diff --git a/iiod/ops.c b/iiod/ops.c
index 95290a4..1c03569 100644
--- a/iiod/ops.c
+++ b/iiod/ops.c
@@ -114,6 +114,8 @@ struct DevEntry {
 	pthread_mutex_t thdlist_lock;
 
