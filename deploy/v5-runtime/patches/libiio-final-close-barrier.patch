@@ -872,6 +875,11 @@ static void rw_thd(struct thread_pool *pool, void *d)
 		iio_device_set_data(dev, NULL);
 	pthread_mutex_unlock(&devlist_lock);
 
+	pthread_mutex_lock(&entry->thdlist_lock);
+	entry->teardown_complete = true;
+	pthread_cond_broadcast(&entry->teardown_complete_cond);
+	pthread_mutex_unlock(&entry->thdlist_lock);
+
 	IIO_DEBUG("Stopping R/W thread for device %s\n",
 		  dev_label_or_name_or_id(dev));
 
@@ -985,21 +993,29 @@ static void free_thd_entry(struct ThdEntry *t)
 	free(t);
 }
 
-static void remove_thd_entry(struct ThdEntry *t)
+static void remove_thd_entry(struct ThdEntry *t, bool wait_for_teardown)
 {
 	struct DevEntry *entry = t->entry;
+	bool final_client = false;
 
 	pthread_mutex_lock(&entry->thdlist_lock);
 	if (!entry->closed) {
 		entry->update_mask = true;
 		SLIST_REMOVE(&entry->thdlist_head, t, ThdEntry, dev_list_entry);
-		if (SLIST_EMPTY(&entry->thdlist_head) && entry->buf) {
+		final_client = SLIST_EMPTY(&entry->thdlist_head);
+		if (final_client && entry->buf) {
 			entry->cancelled = true;
 			iio_buffer_cancel(entry->buf); /* Wakeup the rw thread */
 		}
 
 		pthread_cond_signal(&entry->rw_ready_cond);
+	} else {
+		/* The worker has already detached this client after an error. */
+		final_client = true;
 	}
+	while (wait_for_teardown && final_client && !entry->teardown_complete)
+		pthread_cond_wait(&entry->teardown_complete_cond,
+				&entry->thdlist_lock);
 	pthread_mutex_unlock(&entry->thdlist_lock);
 	dev_entry_put(entry);
 
